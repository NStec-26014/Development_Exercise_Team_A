<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.mapper.CategoryMapper">

    <resultMap id="CategoryResult" type="com.example.fullness.stationary.entity.Category">
        <id property="id" column="id" />
        <result property="name" column="name" />
    </resultMap>

    <select id="findAll" resultMap="CategoryResult">
        SELECT id, name
        FROM product_category
        ORDER BY id
    </select>

    <select id="findById" parameterType="long" resultMap="CategoryResult">
        SELECT id, name
        FROM product_category
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.example.fullness.stationary.entity.Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_category (name)
        VALUES (#{name})
    </insert>

        <select id="findByCategoryName" resultMap="CategoryResult">
        SELECT id, name
        FROM product_category
        WHERE name = #{categoryName}
    </select>


</mapper>
