<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.mapper.EmployeeMapper">

    <resultMap id="employeeResultMap" type="com.example.fullness.stationary.entity.Employee">
        <id property="id" column="id" />
        <result property="departmentId" column="department_id" />
        <result property="name" column="name" />
        <result property="nameKana" column="name_kana" />
    </resultMap>

    <select id="selectById" resultMap="employeeResultMap">
        SELECT 
            id,
            department_id,
            name,
            name_kana
        FROM employee
        WHERE id = #{id}
    </select>

</mapper>